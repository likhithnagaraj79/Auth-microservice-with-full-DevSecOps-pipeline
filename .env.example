# Server
PORT=8080
ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=authdb
DB_USER=postgres
DB_PASSWORD=your_strong_password_here
DB_SSLMODE=disable

# JWT — change both secrets before deploying!
JWT_ACCESS_SECRET=replace_with_32+_char_random_secret
JWT_REFRESH_SECRET=replace_with_different_32+_char_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Google OAuth (get from console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/google/callback
